  "стили": [
    "styles.css: --ink-quiet: #7c848e;",
    "styles.css: --accent: #1257d6;",
    "styles.css: --знак-тревоги: #c8102e;",
    "styles.css: .lang-ask { display: flex; align-items: center; gap: 6px; margin-left: 10px; font-size: 12px; }",
    "styles.css: .lang { display: inline-flex; flex-direction: column; align-items: center; border: 0; background: transparent; color: var(--ink-quiet); border-radius: 999px; padding: 2px 4px; font-size: 12px; line-height: 1.1; }",
    "styles.css: .lang-сверху, .lang-снизу { display: flex; align-items: center; justify-content: center; gap: 2px; height: 8px; }",
    "styles.css: .lang-сверху { align-items: flex-end; }",
    "styles.css: .lang-точка { width: 5px; height: 5px; border-radius: 50%; }",
    "styles.css: .lang-точка-изменена { background: var(--знак-тревоги); }",
    "styles.css: .lang-ссылка { width: 9px; height: 9px; display: block; }",
    "styles.css: .lang-цвет-обычная { color: var(--ink-quiet); }",
    "styles.css: .lang-цвет-новая { color: var(--accent); }",
    "styles.css: .lang-цвет-черновик { color: var(--знак-тревоги); }",
    "styles.css: .lang-цвет-нет { opacity: 0.35; cursor: default; }",
    "styles.css: .lang-on { background: var(--bg-soft); box-shadow: inset 0 0 0 1px var(--line); font-weight: 600; }",
    "styles.css: .layer-site { color: var(--layer-site); }",
    "styles.css: .layer-prevHuman { color: var(--layer-prevHuman); }",
    "styles.css: .layer-prevAi { color: var(--layer-prevAi); }",
    "styles.css: .layer-prevOther { color: var(--layer-prevOther); }",
    "styles.css: .layer-current { color: var(--layer-current); }",
    "styles.css: .mono .layer-site, .mono .layer-prevHuman, .mono .layer-prevAi, .mono .layer-prevOther, .mono .layer-current { color: var(--ink); }",
    "registry.css: .cell-langs .lang { padding: 1px 2px; font-size: 10px; }",
    "registry.css: .lang-срыв { background: var(--layer-deleted); opacity: 1; }",
    "registry.css: .lang-срыв .lang-код { color: #fff; }"
