      { "wrong": ["типы линий"], "right": "Образцы линий", "context": "Line Patterns, Управление → Дополнительные параметры", "requiresContext": ["Дополнительные параметры", "IMPORT"], "$comment": "«Типы линий» — законный термин AutoCAD. Ошибкой считается только когда речь о диалоге Revit." },
      { "wrong": ["создать подобный", "создание подобного элемента"], "right": "Создать аналог", "context": "Create Similar" },
      { "wrong": ["копирование свойств типа", "совпадение свойств", "сравнение типа"], "right": "Сопоставление свойств типа", "context": "Match Type Properties, кнопка на ленте" },
      { "wrong": ["выделить все экземпляры", "выбрать все элементы типа"], "right": "Выбрать все экземпляры", "context": "Select All Instances" },
      { "wrong": ["секущая рамка", "секущий бокс", "Section Box"], "right": "Границы 3D-вида", "context": "Section Box в свойствах 3D-вида" },
      { "wrong": ["закрыть скрытые окна"], "right": "Закрыть неактивные виды", "context": "Close Inactive Views, с Revit 2019" },
      { "wrong": ["ключевые спецификации помещений", "спецификация ключей"], "right": "Ключевая спецификация", "context": "Key Schedule" },
      { "wrong": ["менеджер связей", "управление связями"], "right": "Диспетчер связей", "context": "Manage Links" },
      { "wrong": ["формообразующий на месте", "модель на месте"], "right": "Модель в контексте", "context": "Model In-Place" },
      { "wrong": ["подпроекты"], "right": "Рабочие наборы", "context": "Worksets" }
