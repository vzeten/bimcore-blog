# Dependencies
/node_modules

# Временная копия сборки плана: рабочее дерево git на время одной проверки, живёт внутри
# корня нарочно — так сборщик находит зависимости проекта без всякой связи на них.
/.editor-plan-*

# Production
/build

# Generated files
.docusaurus
.cache-loader

# Migration scratch (knowledge.bimcore.one → MDX converter, source HTML snapshots, intermediate MD).
# Keep convert.js around for batch ПП2; ignore downloaded HTML, node_modules, intermediates.
/_tmp

# Claude Code — личные настройки машины (разрешения и т.п.), не коммитим.
# launch.json (конфиги dev-сервера) — общий, его коммитим.
.claude/settings.local.json

# Приёмник Word-файлов от редакторов (исходники статей, конвертируются скриптом).
# Бинарные .docx в репозиторий не коммитим.
/_word_inbox

# Страница ревью правок (генерируется скриптом review-page.js под конкретный показ владельцу)
/review
/review-notes.json

# Локальный редактор статей: зависимости и сборка не коммитятся.
/editor/node_modules
/editor/dist

# Misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# knowledge-redirect: сборка и зависимости FastEdge-функции (в git только исходники)
scripts/knowledge-redirect/node_modules/
scripts/knowledge-redirect/dist/



# Черновые снимки правок редактора: после публикации не нужны, в репозиторий не идут
/editor/.history
# Оригиналы картинок и текста до «Доработать»: страховка программы, не содержимое сайта
/editor/.originals
# Автосохранённые черновики редактора: рабочее состояние до кнопки «Сохранить», в репозиторий не идут
/editor/.drafts
# Старые черновики, между которыми программа не выбирала: тоже незаписанная работа, не содержимое сайта
/editor/.drafts-споры
# Стороны нерешённого расхождения с внешней правкой: рабочее состояние программы, не содержимое сайта
/editor/.сведение
# Память перекладки: какие тексты старого хранилища уже предлагали человеку
/editor/.drafts-перенесено.json
# Корзина удалённых статей: восстанавливаемый архив программы, не содержимое сайта.
/editor/.trash
# Запомненные просмотры из Google Analytics: числа по дням, без ключа; состояние программы, не содержимое сайта
/editor/.views
# База аналитики изменений и Поиска Google (SQLite): события и числа, без ключа; состояние программы
/editor/.analytics
# Временные файлы атомарной записи картинок: живут мгновение, после сбоя не должны попасть в коммит
/editor/.tmp
# Очередь коммитов, сделанных самой программой: доказательство их происхождения, не история проекта
/editor/.publish
# Память панели экземпляров и слова запущенных ею серверов: состояние этой машины, не код проекта
/editor/.panel/
# Временный обмен Claude и Codex: отчёты, доказательства и ID локальной сессии проверяющего
/editor/.coordination/
