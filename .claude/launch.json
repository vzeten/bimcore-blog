{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "docusaurus",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["start"],
      "port": 3000
    },
    {
      "name": "docusaurus-ru",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["start", "--", "--locale", "ru"],
      "port": 3000
    },
    {
      "name": "editor",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "editor:dev"],
      "port": 4780
    },
    {
      "name": "docusaurus-serve",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "serve", "--", "--port", "3000"],
      "port": 3000
    }
  ]
}
